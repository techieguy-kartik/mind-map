# Keep secrets on the server. Never commit .env.
# AWS containers should set only this identifier and load values through IAM.
ATLAS_RUNTIME_SECRET_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ATLAS_DB=var/atlas.sqlite3
ATLAS_DEMO=true
# Required by start.sh when binding beyond loopback. Use at least 24 random characters.
ATLAS_ACCESS_TOKEN=
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
ATLAS_DAILY_INVESTIGATIONS=10
# Successful collection checks older than this are reported as stale.
ATLAS_FRESHNESS_SECONDS=1800
ATLAS_SOURCE_MIN_INTERVAL_SECONDS=60
# Enable only when analysis jobs run on the optional Python 3.13 CrewAI image.
ATLAS_CREW_ENABLED=false
# Set by Terraform/SSM in AWS. Leave blank for the in-process local fallback.
ATLAS_INGESTION_QUEUE_URL=
ATLAS_ANALYSIS_QUEUE_URL=
ATLAS_CONTROL_TABLE=
ATLAS_EVIDENCE_BUCKET=
AWS_REGION=us-east-1
# Set true only behind an HTTPS reverse proxy.
ATLAS_SECURE_COOKIE=false
